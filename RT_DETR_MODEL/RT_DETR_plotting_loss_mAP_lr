if __name__ == "__main__":
    df = pd.read_csv(CSV_FILE)
    save_dir = os.path.join(OUTPUT_DIR, RUN_FOLDER_NAME)
    ensure_dir(save_dir)

    if PLOT_LOSS:
        plot_loss_curves_full(df, save_dir)
        if PLOT_TRIMMED_LOSS:
            plot_loss_curves_trimmed(df, save_dir, TRIM_PCT)

    if PLOT_MAP:
        plot_map_curves_full(df, save_dir)
        if PLOT_TRIMMED_MAP:
            plot_map_curves_trimmed(df, save_dir, TRIM_PCT)

    if PLOT_LR:
        plot_lr_curves_full(df, save_dir)
        if PLOT_TRIMMED_LR:
            plot_lr_curves_trimmed(df, save_dir, TRIM_PCT)

    print(f"All requested plots saved under {save_dir}")