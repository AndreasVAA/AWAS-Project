def plot_lr_curves_full(df, save_folder):
    plt.figure()
    for lr in ['lr/pg0','lr/pg1','lr/pg2']:
        if lr in df:
            plt.plot(df['epoch'], df[lr], label=lr)
    plt.title("LR Curves (full)")
    plt.xlabel("Epoch")
    plt.ylabel("Learning Rate")
    plt.legend()
    plt.grid(True)
    out = os.path.join(save_folder, "lr_curves_full.png")
    plt.savefig(out); plt.close()
    print(f"Saved {out}")

